# 复制为 .env 并填入你的真实Key；.env已被gitignore，不会提交
# DeepSeek开放平台 https://platform.deepseek.com 申请
DEEPSEEK_API_KEY=sk-在这里填入你的Key

# 可选：指定生成模型（默认 deepseek-chat，即V3系列对话模型）
# DEEPSEEK_MODEL=deepseek-chat

# 智谱开放平台 https://open.bigmodel.cn 申请
ZHIPU_API_KEY=
# 可选：视觉模型型号（默认 glm-4v-flash，免费）
# ZHIPU_VISION_MODEL=glm-4v-flash
